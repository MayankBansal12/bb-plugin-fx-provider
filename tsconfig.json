{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "host.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
    "src/**/*.ts"
  ]
}
